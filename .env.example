# Copy to .env and fill in your values.

# Postgres connection string (Neon, Supabase, Vercel Postgres, or local).
# Neon gives you this on the project dashboard — use the POOLED connection.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin auth
ADMIN_PASSWORD="change-me"        # legacy fallback; staff accounts are seeded via prisma/seed.ts
AUTH_SECRET="generate-a-long-random-string"

# --- Email: EmailJS (preferred — sends via your connected Gmail to any recipient) ---
# https://dashboard.emailjs.com  → see README "EmailJS setup"
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""          # booking confirmation (designed template)
EMAILJS_TEMPLATE_ID_GENERIC=""  # reminders/notifications — body just {{{message_html}}}
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""

# --- Communication (Phase 2) ---
CLINIC_NOTIFY_EMAIL=""          # where staff booking alerts + daily digest go
GOOGLE_REVIEW_URL=""            # e.g. https://g.page/r/XXXX/review — adds a Google link to the review flow
CRON_SECRET=""                  # protects /api/cron in production (Vercel Cron bearer token)

# --- Email: Resend (fallback — used only if EmailJS vars are empty) ---
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Absolute base for links sent by email (manage / intake / review / portal).
# Required in production — falls back to the Vercel deployment URL if unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
