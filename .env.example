# Copy to .env and fill in your values.

DATABASE_URL="file:./prisma/dev.db"

# Admin auth
ADMIN_PASSWORD="change-me"        # legacy fallback; staff accounts are seeded via prisma/seed.ts
AUTH_SECRET="generate-a-long-random-string"

# --- Email: EmailJS (preferred — sends via your connected Gmail to any recipient) ---
# https://dashboard.emailjs.com  → see README "EmailJS setup"
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""

# --- Email: Resend (fallback — used only if EmailJS vars are empty) ---
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
